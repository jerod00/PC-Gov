# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets.

# --- SAM.gov Opportunities API ---
# Get a free key at https://sam.gov -> sign in -> your profile -> "Account
# Details" -> "Request Public API Key". See README.md for the full walkthrough.
SAM_GOV_API_KEY=

# --- Gmail / Google Workspace SMTP + IMAP (sending the digest and reading
# feedback replies) ---
# GMAIL_ADDRESS is both the sender and recipient for the digest.
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal login
# password. See README.md for how to generate one.
GMAIL_ADDRESS=jerod.mund@palconltd.com
GMAIL_APP_PASSWORD=

# --- Digest recipient(s) (defaults to GMAIL_ADDRESS if unset) ---
# Comma-separated for multiple people. Feedback (thumbs up/down) always
# scans GMAIL_ADDRESS's own inbox regardless of who's listed here, so
# additional recipients still get working feedback links -- they just reply
# to the monitored account, same as the primary recipient does.
DIGEST_RECIPIENT=jerod.mund@palconltd.com,amund@palconltd.com

# --- Anthropic API key (optional) ---
# Powers two optional features: (1) LLM-based relevance judgment layered on
# top of keyword/NAICS scoring (config.yaml llm_scoring.enabled), and (2) the
# occasional source-discovery script (scripts/discover_sources.py). Leave
# blank to skip both -- the daily digest works fine without it, using
# keyword/NAICS scoring only. Get a key at https://console.anthropic.com ->
# Settings -> API Keys. See README.md for setup and rough cost estimates.
ANTHROPIC_API_KEY=

# --- Misc ---
# SQLite DB path, relative to project root unless absolute.
DB_PATH=data/opportunities.db
LOG_PATH=logs/run.log
